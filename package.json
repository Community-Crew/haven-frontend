    "@tailwindcss/vite": "^4.3.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.17.0",
    "keycloak-js": "^26.2.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-i18n": "^10.0.8",
    "vue-router": "^5.0.4"
